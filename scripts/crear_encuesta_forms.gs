function crearEncuesta() {
  var form = FormApp.create('Sostenibilidad digital en empresas de tecnología colombianas');
  form.setDescription('Sostenibilidad digital en empresas de tecnología colombianas\n\nBienvenido y gracias por dedicar unos minutos a este estudio. Su experiencia en el sector tecnológico colombiano es el insumo más valioso de esta investigación.\n\nEsta encuesta busca entender cómo las empresas de tecnología en Colombia incorporan (o no) la eficiencia energética y la sostenibilidad en su infraestructura y en su software. Forma parte de una investigación académica de la Universidad Distrital Francisco José de Caldas basada en un mapeo sistemático de literatura (PRISMA 2020) sobre Green Cloud, Green DevOps y Green Software Engineering, y sus resultados alimentarán la agenda de investigación y las recomendaciones de política pública del estudio.\n\n- No hay respuestas correctas ni incorrectas; esto no es un examen.\n- Duración estimada: 15 a 20 minutos.\n- Puede responder "No sé" o "No aplica" en cualquier punto.\n- Puede saltarse preguntas abiertas que no quiera contestar.\n\nConsentimiento informado: Esta encuesta es un instrumento de investigación académica aplicado por Juan C. Quintero R. y José Bocanegra, investigadores de la Universidad Distrital Francisco José de Caldas. Su propósito es caracterizar la madurez de sostenibilidad digital de las empresas de tecnología colombianas; los resultados se publicarán únicamente de forma agregada y anónima en un artículo académico de acceso abierto.\n\nQuiénes tienen acceso a sus datos: Solo el equipo investigador tiene acceso a las respuestas individuales, que se almacenan en Google Forms y se tratan conforme a la Ley 1581 de 2012 y el Decreto 1377 de 2013. Ninguna otra persona u organización recibirá datos individuales. No se identificará su organización ni a la persona respondiente en ningún reporte; los resultados siempre se presentarán agregados.\n\nTérminos de participación: La participación es voluntaria y sin compensación; puede abandonar la encuesta en cualquier momento sin consecuencia alguna y puede omitir las preguntas abiertas que prefiera no contestar. Los datos se conservarán únicamente durante el tiempo del análisis y la publicación del estudio, y puede solicitar su corrección o eliminación escribiendo a jcquinteror@udistrital.edu.co. Al marcar la casilla de aceptación y continuar, usted confirma que ha leído esta información y acepta participar bajo estos términos.');
  var consent = form.addCheckboxItem();
  consent.setTitle('Consentimiento informado');
  consent.setChoiceValues(['He leído la información anterior y acepto participar de forma voluntaria en esta encuesta.']);
  consent.setRequired(true);
  var pageA = form.addPageBreakItem();
  pageA.setTitle('Sección A — Perfil de la organización');
  pageA.setHelpText('Primero, unos datos básicos para contextualizar sus respuestas según la unidad que usted conoce, de acuerdo con lo indicado en A5.');
  var a1 = form.addMultipleChoiceItem();
  a1.setTitle('A1. Indique la descripción que se acerca más a su organización.');
  a1.setChoiceValues(['Proveedor de cloud, hosting o servicios administrados','Operador o proveedor de centro de datos','Empresa de desarrollo de software / fábrica de software','Consultora de cloud, DevOps, SRE o transformación digital','Startup de producto digital / SaaS','Organización usuaria de tecnología con infraestructura propia o híbrida','Universidad, centro de investigación u organización sin ánimo de lucro']);
  a1.setRequired(true);
  var a1other = a1;
  a1other.setChoice('Otro:').setOtherOption();
  var a2 = form.addMultipleChoiceItem();
  a2.setTitle('A2. Seleccione el tamaño de su organización en Colombia.');
  a2.setChoiceValues(['1–10 personas','11–50','51–200','201–500','Más de 500','Prefiero no responder']);
  a2.setRequired(true);
  var a3 = form.addCheckboxItem();
  a3.setTitle('A3. Indique desde dónde opera principalmente.');
  a3.setChoiceValues(['Bogotá y región','Medellín / Valle de Aburrá','Cali / Valle del Cauca','Barranquilla, Cartagena o Caribe','Eje Cafetero','Operación distribuida a nivel nacional']);
  a3.setRequired(true);
  a3.setChoice('Otra(s):').setOtherOption();
  var a4 = form.addMultipleChoiceItem();
  a4.setTitle('A4. Indique su rol principal.');
  a4.setChoiceValues(['Dirección ejecutiva / CTO','Arquitectura de cloud o de software','DevOps / SRE / plataformas','Infraestructura / centro de datos','Desarrollo de software','Seguridad, riesgo, compliance o ESG','FinOps / gestión financiera de cloud','Académico o investigación']);
  a4.setRequired(true);
  a4.setChoice('Otro:').setOtherOption();
  var a5 = form.addMultipleChoiceItem();
  a5.setTitle('A5. Indique en nombre de quién responde.');
  a5.setChoiceValues(['Mi equipo o área','Toda la organización','No estoy seguro(a)']);
  a5.setRequired(true);
