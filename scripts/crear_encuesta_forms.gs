  dGrid.setTitle('D. Prácticas de infraestructura y nube');
  dGrid.setRows(['Se apagan o consolidan recursos que no se usan (servidores ociosos, ambientes encendidos sin uso)','Se ajusta la capacidad (CPU, memoria, almacenamiento) a la demanda real, sin sobre-dimensionar','Se usa autoescalado o planificación de capacidad para evitar recursos de sobra','Se elige región, proveedor o hardware considerando eficiencia energética o uso de renovables','Se gestiona el fin de vida de los equipos: reutilización, extensión de uso o disposición adecuada de residuos electrónicos (RAEE)','Se usa virtualización, contenedores u orquestación para aprovechar mejor la infraestructura','Se compra o usa energía renovable (acuerdos directos de compra, certificados de energía limpia, microrredes)']);
  dGrid.setColumns(['0','1','2','3','4','No aplica']);
  dGrid.setRequired(true);
  var d8 = form.addMultipleChoiceItem();
  d8.setTitle('D8. Indique si han considerado mover cargas de trabajo a horarios o regiones donde hay más energía renovable disponible (computación consciente del carbono, carbon-aware).');
  d8.setChoiceValues(['Sí, ya lo hacemos en producción','Sí, como piloto o prueba','Lo hemos discutido, pero no lo hemos implementado','No lo hemos considerado','No aplica']);
  d8.setRequired(true);
  var d9 = form.addScaleItem();
  d9.setTitle('D9. Califique cuánto pesa la seguridad energética del país (sequías, racionamientos, variabilidad asociada a El Niño) en la planeación de su infraestructura de TI.');
