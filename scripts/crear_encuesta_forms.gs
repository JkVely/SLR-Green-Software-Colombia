  var d11 = form.addParagraphTextItem();
  d11.setTitle('D11. Describa si ha identificado resistencia interna a alguna práctica de infraestructura relacionada con sostenibilidad digital, y explique brevemente en qué consistió.');
  var pageE = form.addPageBreakItem();
  pageE.setTitle('Sección E — Desarrollo de software');
  pageE.setHelpText('Prácticas en el desarrollo y la operación del software. Misma escala 0–4.\n\nEscala 0–4 (visible en cabecera):\n- 0 = No existe o no conozco\n- 1 = Conocemos el tema, pero no hay acciones formales\n- 2 = Hay pilotos o iniciativas aisladas\n- 3 = Práctica documentada, aplicada en parte de la organización\n- 4 = Integrada: se mide periódicamente y se mejora\n\nCómo rellenar la cuadrícula E:\n- Cada fila describe una práctica de ingeniería.\n- Responda por la unidad que conoce (ver A5).\n- Elija un solo valor por fila reflejando la situación actual en los últimos 12 meses.');
  var eGrid = form.addGridItem();
  eGrid.setTitle('E. Prácticas en el desarrollo y la operación del software');
  eGrid.setRows(['Los requisitos del software incluyen metas de eficiencia, consumo energético o huella de carbono','Se evalúan arquitecturas considerando cómputo, transferencia de datos, caché y almacenamiento','Las pruebas de rendimiento revisan también consumo de energía o emisiones','Los pipelines de CI/CD (integración continua / entrega continua) evitan compilaciones redundantes o ambientes encendidos sin uso','Se aplican prácticas de eficiencia de datos: retención, compresión, deduplicación, caché','Se considera el impacto de dependencias, librerías, modelos de IA o servicios externos que se usan']);
  eGrid.setColumns(['0','1','2','3','4','No aplica']);
  eGrid.setRequired(true);
  var e7 = form.addParagraphTextItem();
  e7.setTitle('E7. Indique qué aspectos le resultan más difíciles para incorporar eficiencia energética al diseñar software.');
  var pageC = form.addPageBreakItem();
  pageC.setTitle('Sección C — Medición y observabilidad');
  pageC.setHelpText('Cómo miden o no el impacto energético de lo que operan, en los últimos 12 meses.');
  var c1 = form.addCheckboxItem();
  c1.setTitle('C1. Seleccione qué mide hoy sobre consumo y emisiones de su infraestructura o servicios.');
  c1.setChoiceValues(['Consumo eléctrico (kWh)','PUE (Power Usage Effectiveness, eficiencia energética del centro de datos: cuánta energía se pierde en refrigeración y soporte vs. en cómputo)','Emisiones de carbono (CO₂e)','Intensidad de carbono de la red eléctrica (gCO₂e por kWh)','Emisiones incorporadas del hardware (fabricación, transporte, disposición)','Energía o carbono por servicio, por transacción o por usuario','Utilización de servidores o máquinas virtuales','Uso de agua','Ninguna (marque solo esta)','No sé (marque solo esta)']);
  c1.setRequired(true);
  var c2 = form.addCheckboxItem();
  c2.setTitle('C2. Seleccione hasta qué nivel puede saber cuánto gasta cada cosa.');
  c2.setChoiceValues(['Instalación o centro de datos completo','Servidor individual','Máquina virtual','Clúster de contenedores (Kubernetes)','Contenedor','Aplicación o microservicio','Solicitud API o transacción','Job de datos o IA','No se mide']);
  c2.setRequired(true);
  var c3 = form.addCheckboxItem();
  c3.setTitle('C3. Seleccione con qué herramientas o fuentes miden o estiman esto.');
  c3.setChoiceValues(['BMS o DCIM (Building Management System / Data Center Infrastructure Management, sistemas del centro de datos)','Facturas de energía o medidores','Paneles del proveedor de nube','Prometheus / Grafana','OpenTelemetry','Kepler / eBPF (trazado de uso de energía a nivel de kernel/contenedor)','Cloud Carbon Footprint','Herramienta ESG interna o de terceros','Hojas de cálculo']);
  c3.setRequired(true);
  c3.setChoice('Otra:').setOtherOption();
  var c4 = form.addMultipleChoiceItem();
  c4.setTitle('C4. Indique con qué frecuencia revisan estos indicadores en los últimos 12 meses.');
  c4.setChoiceValues(['Nunca','Solo cuando hay un proyecto o incidente','Una vez al año','Trimestralmente','Mensualmente','Semanal o en tiempo casi real','No aplica']);
  c4.setRequired(true);
  var c5 = form.addMultipleChoiceItem();
  c5.setTitle('C5. Indique si relacionan el impacto ambiental con el valor que entrega el servicio.');
  c5.setChoiceValues(['Sí, de forma sistemática','Sí, en pilotos','No, pero nos interesa','No, y no está en nuestros planes','No sé']);
  c5.setHelpText('Ejemplo: saber cuántas emisiones genera cada transacción, cada usuario activo o cada informe generado, para decidir si el gasto energético se justifica.');
  c5.setRequired(true);
  var c6 = form.addCheckboxItem();
  c6.setTitle('C6. Seleccione qué le dificulta más atribuir energía o carbono a un servicio.');
