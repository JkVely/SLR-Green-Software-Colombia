  var b8 = form.addParagraphTextItem();
  b8.setTitle('B8. En sus propias palabras, describa qué entiende su organización por la idea mencionada en B7.');
  var b9 = form.addParagraphTextItem();
  b9.setTitle('B9. Describa qué factores considera que limitan hoy una adopción más amplia de estas prácticas en su organización.');
